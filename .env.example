# =============================================================================
# GWV-xuk backend — example environment file
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# =============================================================================

PROJECT_NAME="GWV-xuk"

# --- Supabase (database, auth, storage) -------------------------------------
# Use the SERVICE ROLE key on the backend. It bypasses RLS (trusted server).
# Never ship this key to the frontend — the browser uses the anon key + RLS.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-service-role-key"

# --- CORS (comma-separated browser origins allowed to call this API) ---------
# Storefront (5173) + Admin dashboard (5174) + legacy CRA (3000)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000,http://10.44.134.253:5173,http://10.44.134.253:5174"

# --- Access control ----------------------------------------------------------
# Comma-separated admin emails (fastest way to grant admin).
# Long-term: use the `role` column on `profiles` instead.
ADMIN_EMAILS="owner@x-uk.com"

# --- Generic secrets (used by auth/other services) ---------------------------
SECRET_KEY="change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"

# --- M-Pesa Daraja -----------------------------------------------------------
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE="174379"
DARAJA_BUSINESS_SHORTCODE="174379"
DARAJA_PASSKEY=""
DARAJA_IS_SANDBOX="true"
DARAJA_CALLBACK_URL="https://your-domain/payments/callback"
DARAJA_SECURITY_CREDENTIAL=""

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=""

# --- AI (OpenRouter for the assistant; reused by the WhatsApp bot) -----------
OPENROUTER_API_KEY=""
# Optional alternative providers
GROQ_API_KEY=""
GEMINI_API_KEY=""
HF_TOKEN=""

# --- WhatsApp Cloud API (triage bot) -----------------------------------------
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""        # Meta App Secret — used to verify webhook signatures
OWNER_WHATSAPP_NUMBER=""
